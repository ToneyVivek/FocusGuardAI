# Environment Configuration
ENVIRONMENT=development

# Database Configuration
# For PostgreSQL: postgresql://username:password@localhost:5432/focusguard
# Fallback local testing: sqlite:///./focusguard.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusguard

# Security / JWT Configuration
# Development: minimum 16 characters
# Production: minimum 32 characters, avoid common patterns
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-at-least-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated allowed origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@focusguard.ai
SMTP_FROM_NAME=FocusGuard AI Onboarding

# Application URLs
BASE_URL=http://localhost:3000

# AI Provider Configuration
# Provider failover order (comma-separated): gemini,grok,openai,mock
# - gemini: Uses Google Gemini models (requires GEMINI_API_KEYS)
# - grok: Uses xAI Grok models (requires GROK_API_KEY)
# - openai: Uses OpenAI GPT models (requires OPENAI_API_KEY)
# - mock: Uses mock data for testing (no API calls)
AI_PROVIDER_ORDER=gemini,grok,openai,mock

# OpenAI Configuration (optional, for failover)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (comma-separated API keys for rotation)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-flash-latest  # Auto-selects working Flash model on startup

# Grok (xAI) Configuration (optional, for failover)
GROK_API_KEY=
GROK_MODEL=grok-4.5

# AI Request Configuration
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=1
AI_MAX_CONTEXT_TOKENS=120000

# AI Cache Configuration
AI_DAILY_CACHE_TTL_HOURS=4
AI_WEEKLY_CACHE_TTL_HOURS=24
