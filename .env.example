# Environment Configuration
ENVIRONMENT=development

# Database Configuration
# For PostgreSQL: postgresql://username:password@localhost:5432/focusguard
# Fallback local testing: sqlite:///./focusguard.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusguard

# Security / JWT Configuration
# Development: minimum 16 characters
# Production: minimum 32 characters, avoid common patterns
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-at-least-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated allowed origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@focusguard.ai
SMTP_FROM_NAME=FocusGuard AI Onboarding

# Application URLs
BASE_URL=http://localhost:3000
